# ============================================================================
# Enterprise Playwright Automation Framework - Toolshop v5.0 Configuration
# ============================================================================
# Target Environment: qa | staging | prod
TEST_ENV=qa

# Primary Web Application Under Test (Toolshop v5.0 Angular 18 Platform)
BASE_URL=https://practicesoftwaretesting.com

# Primary REST API Endpoint (Toolshop v5.0 Laravel REST API)
API_BASE_URL=https://api.practicesoftwaretesting.com

# Default Enterprise Personas & Credentials
CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
CUSTOMER_SECONDARY_EMAIL=customer2@practicesoftwaretesting.com
ADMIN_EMAIL=admin@practicesoftwaretesting.com
DEFAULT_PASSWORD=welcome01

# Execution & Performance Tuning
HEADLESS=true
WORKERS=6
RETRIES=1
ENABLE_ASSET_CACHE=true
DEFAULT_TIMEOUT_MS=30000
EXPECT_TIMEOUT_MS=10000
